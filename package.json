{
  "name": "namhastro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NAMH ASTRO — Enterprise Astrology Consultation Marketplace",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @namhastro/web dev",
    "dev:api": "pnpm --filter @namhastro/api dev",
    "dev:web": "pnpm --filter @namhastro/web dev",
    "build": "pnpm --filter @namhastro/web build",
    "build:all": "pnpm -r build",
    "start": "pnpm --filter @namhastro/web start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @namhastro/api db:generate",
    "db:migrate": "pnpm --filter @namhastro/api db:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
