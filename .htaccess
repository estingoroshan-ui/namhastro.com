DirectoryIndex index.html index.php

<IfModule mod_mime.c>
  AddType text/x-component .rsc
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.rsc$">
    Header set Content-Type "text/x-component"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API router: forward all /api/* requests to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Direct static assets & Next.js chunks
  RewriteRule ^_next/(.*)$ _next/$1 [L]
  RewriteRule ^images/(.*)$ images/$1 [L]

  # 3. Next.js React Server Component (RSC) requests
  RewriteCond %{HTTP:RSC} "1" [OR]
  RewriteCond %{QUERY_STRING} (^|&)_rsc= [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.rsc -f
  RewriteRule ^([^/]+)/?$ $1.rsc [T=text/x-component,L]

  RewriteCond %{HTTP:RSC} "1" [OR]
  RewriteCond %{QUERY_STRING} (^|&)_rsc= [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/$2.rsc -f
  RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.rsc [T=text/x-component,L]

  # 4. Direct files (e.g. .css, .js, .png, .jpg, .svg, .rsc, favicon.ico, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Standalone Route .html matching (handles /admin, /partner, /account, /kundli, /horoscope, etc.)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # 6. Nested route .html matching (handles /account/wallet, /admin/dashboard, etc.)
  RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
  RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.html [L]

  # 7. Directory index matching (if directory contains index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 8. Single Page Application fallback for dynamic routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
