# ==============================================================================
# NAMH ASTRO — Environment Configuration Template
# Copy to .env and populate with real credentials. NEVER commit .env to Git.
# ==============================================================================

NODE_ENV=development
APP_DOMAIN=https://namhastro.com
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (MySQL 8.0+ / MariaDB 10.4+)
DATABASE_URL="mysql://root:@127.0.0.1:3306/namhastro"

# Redis (Sessions, Queues, Socket.IO Adapter, OTP Rate Limiting)
REDIS_URL="redis://127.0.0.1:6379"

# Security & JWT (Generate 64-byte random hex strings for production)
JWT_ACCESS_SECRET="replace-with-secure-64-byte-secret"
JWT_REFRESH_SECRET="replace-with-secure-64-byte-secret"

# Pending Production Integrations (Configured in Steps 3-11)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RTC_PROVIDER=""
RTC_APP_ID=""
RTC_APP_CERTIFICATE=""
OTP_PROVIDER_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
FCM_PROJECT_ID=""
ASTROLOGY_API_KEY=""
STORAGE_BUCKET=""
