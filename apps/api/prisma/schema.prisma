generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ASTROLOGER
  SUPPORT
  FINANCE
  VERIFICATION
  MARKETING
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStage {
  APPLIED
  DOC_VERIFICATION
  INTERVIEW
  APPROVED
  TRAINING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum LedgerEntryType {
  WALLET_RECHARGE
  PROMO_CREDIT
  CONSULTATION_DEBIT
  LIVE_QUESTION_DEBIT
  PUJA_PAYMENT
  STORE_PAYMENT
  REFUND_CREDIT
  ADMIN_ADJUSTMENT
}

model User {
  id                 String        @id @default(cuid())
  role               UserRole      @default(CUSTOMER)
  status             AccountStatus @default(PENDING_VERIFICATION)
  fullName           String        @db.VarChar(120)
  email              String?       @unique @db.VarChar(191)
  emailVerifiedAt    DateTime?
  phoneE164          String?       @unique @db.VarChar(20)
  phoneVerifiedAt    DateTime?
  passwordHash       String?       @db.VarChar(255)
  preferredLanguage  String        @default("en") @db.VarChar(16)
  mfaEnabled         Boolean       @default(false)
  termsAcceptedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  wallet             Wallet?
  astrologerProfile  AstrologerProfile?
  auditLogs          AuditLog[]    @relation("AuditActor")

  @@index([role, status])
  @@map("users")
}

model AstrologerProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  slug                  String             @unique @db.VarChar(140)
  displayName           String             @db.VarChar(120)
  verificationStage     VerificationStage  @default(APPLIED)
  availabilityStatus    AvailabilityStatus @default(OFFLINE)
  chatEnabled           Boolean            @default(false)
  audioEnabled          Boolean            @default(false)
  videoEnabled          Boolean            @default(false)
  experienceYears       Int                @default(0)
  bio                   String?            @db.Text
  qualifications        String?            @db.Text
  chatRatePaise         Int                @default(0)
  audioRatePaise        Int                @default(0)
  videoRatePaise        Int                @default(0)
  commissionBpsOverride Int?
  avatarUrl             String?            @db.VarChar(512)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStage, availabilityStatus])
  @@map("astrologer_profiles")
}

model Wallet {
  id                  String              @id @default(cuid())
  userId              String              @unique
  currency            String              @default("INR") @db.VarChar(3)
  paidBalancePaise    BigInt              @default(0)
  promoBalancePaise   BigInt              @default(0)
  refundBalancePaise  BigInt              @default(0)
  version             Int                 @default(1)
  updatedAt           DateTime            @updatedAt
  createdAt           DateTime            @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                  String          @id @default(cuid())
  walletId            String
  idempotencyKey      String          @unique @db.VarChar(128)
  type                LedgerEntryType
  amountPaise         BigInt
  balanceAfterPaise   BigInt
  referenceType       String?         @db.VarChar(64)
  referenceId         String?         @db.VarChar(128)
  description         String          @db.VarChar(255)
  metadataJson        Json?
  createdAt           DateTime        @default(now())

  wallet              Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model SystemSetting {
  key         String   @id @db.VarChar(120)
  valueJson   Json
  description String?  @db.VarChar(255)
  updatedBy   String?  @db.VarChar(64)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(128)
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  payloadJson Json?
  createdAt   DateTime @default(now())

  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
