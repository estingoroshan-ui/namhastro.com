model PujaCategory {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(120)
  slug            String         @unique @db.VarChar(140)
  description     String?        @db.Text
  iconUrl         String?        @db.VarChar(255)
  bannerUrl       String?        @db.VarChar(255)
  displayOrder    Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  services        PujaService[]

  @@map("puja_categories")
}

model PujaService {
  id                    String            @id @default(cuid())
  categoryId            String
  name                  String            @db.VarChar(160)
  slug                  String            @unique @db.VarChar(180)
  shortDescription      String            @db.VarChar(255)
  detailedDescription   String            @db.Text
  significance          String?           @db.Text
  procedure             String?           @db.Text
  durationMinutes       Int               @default(60)
  samagriList           String?           @db.Text
  inclusions            String?           @db.Text
  exclusions            String?           @db.Text
  coverImageUrl         String?           @db.VarChar(255)
  galleryImagesJson     Json?
  videoUrl              String?           @db.VarChar(255)
  templeId              String?
  availableLanguagesJson Json?
  regularPricePaise     BigInt            @default(0)
  discountedPricePaise  BigInt            @default(0)
  taxRateBps            Int               @default(1800)
  bookingCapacity       Int               @default(10)
  cancellationPolicy    String?           @db.Text
  refundPolicy          String?           @db.Text
  metaTitle             String?           @db.VarChar(200)
  metaDescription       String?           @db.VarChar(300)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  category              PujaCategory      @relation(fields: [categoryId], references: [id])
  temple                Temple?           @relation(fields: [templeId], references: [id])
  packages              PujaPackage[]
  addOns                PujaAddOn[]
  bookings              PujaBooking[]

  @@index([categoryId, isActive])
