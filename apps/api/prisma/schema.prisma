generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ASTROLOGER
  SUPPORT
  FINANCE
  VERIFICATION
  MARKETING
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStage {
  APPLIED
  DOC_VERIFICATION
  INTERVIEW
  APPROVED
  TRAINING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum LedgerEntryType {
  WALLET_RECHARGE
  PROMO_CREDIT
  CONSULTATION_DEBIT
  LIVE_QUESTION_DEBIT
  PUJA_PAYMENT
  STORE_PAYMENT
  REFUND_CREDIT
  ADMIN_ADJUSTMENT
  CONSULTATION_HOLD
  HOLD_RELEASE
}

model User {
  id                   String        @id @default(cuid())
  role                 UserRole      @default(CUSTOMER)
  status               AccountStatus @default(PENDING_VERIFICATION)
  fullName             String        @db.VarChar(120)
  email                String?       @unique @db.VarChar(191)
  emailVerifiedAt      DateTime?
  phoneE164            String?       @unique @db.VarChar(20)
  phoneVerifiedAt      DateTime?
  passwordHash         String?       @db.VarChar(255)
  preferredLanguage    String        @default("en") @db.VarChar(16)
  mfaEnabled           Boolean       @default(false)
  termsAcceptedAt      DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customerProfile      CustomerProfile?
  wallet               Wallet?
  astrologerProfile    AstrologerProfile?
  authSessions         AuthSession[]
  birthProfiles        BirthProfile[]
  favourites           AstrologerFavourite[]
  following            AstrologerFollower[]
  availabilitySubs     AvailabilitySubscription[]
  appointments         Appointment[]              @relation("CustomerAppointments")
  consultationRequests ConsultationRequest[]      @relation("CustomerConsultationRequests")
  supportTickets       SupportTicket[]            @relation("CustomerTickets")
  sentMessages         SupportMessage[]           @relation("MessageSender")
  notifications        Notification[]
  notificationPref     NotificationPreference?
  savedAddresses       SavedAddress[]
  auditLogs            AuditLog[]                 @relation("AuditActor")
  astrologerApplications AstrologerApplication[]
  deviceTokens         DeviceToken[]
  paymentOrders        PaymentOrder[]
  gstInvoices          GstInvoice[]

  @@index([role, status])
  @@map("users")
}

model CustomerProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  avatarUrl             String?   @db.VarChar(512)
  dateOfBirth           DateTime? @db.Date
  timeOfBirth           String?   @db.VarChar(16)
  isBirthTimeUnknown    Boolean   @default(false)
  birthPlace            String?   @db.VarChar(191)
  birthLatitude         Float?
  birthLongitude        Float?
  birthTimezone         String?   @default("Asia/Kolkata") @db.VarChar(64)
  currentCity           String?   @db.VarChar(120)
  gender                String?   @db.VarChar(20)
  maritalStatus         String?   @db.VarChar(32)
  consultationInterests Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @db.VarChar(255)
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model OTPRequest {
  id         String    @id @default(cuid())
  phoneE164  String    @db.VarChar(20)
  otpHash    String    @db.VarChar(255)
  purpose    String    @default("LOGIN") @db.VarChar(32)
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  ipAddress  String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([phoneE164, purpose])
  @@map("otp_requests")
}

model BirthProfile {
  id                 String    @id @default(cuid())
  userId             String
  relation           String    @default("SELF") @db.VarChar(32)
  fullName           String    @db.VarChar(120)
  gender             String?   @db.VarChar(20)
  dateOfBirth        DateTime  @db.Date
  timeOfBirth        String?   @db.VarChar(16)
  isBirthTimeUnknown Boolean   @default(false)
  birthPlace         String    @db.VarChar(191)
  latitude           Float?
  longitude          Float?
  timezone           String?   @default("Asia/Kolkata") @db.VarChar(64)
  maritalStatus      String?   @db.VarChar(32)
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("birth_profiles")
}

model AstrologerProfile {
  id                    String                     @id @default(cuid())
  userId                String                     @unique
  slug                  String                     @unique @db.VarChar(140)
  displayName           String                     @db.VarChar(120)
  verificationStage     VerificationStage          @default(APPLIED)
  availabilityStatus    AvailabilityStatus         @default(OFFLINE)
  isOnline              Boolean                    @default(false)
  chatEnabled           Boolean                    @default(false)
  audioEnabled          Boolean                    @default(false)
  videoEnabled          Boolean                    @default(false)
  experienceYears       Int                        @default(0)
  bio                   String?                    @db.Text
  qualifications        String?                    @db.Text
  chatRatePaise         Int                        @default(0)
  audioRatePaise        Int                        @default(0)
  videoRatePaise        Int                        @default(0)
  commissionBpsOverride Int?
  avatarUrl             String?                    @db.VarChar(512)
  averageRating         Float                      @default(4.9)
  totalReviews          Int                        @default(0)
  totalConsultations    Int                        @default(0)
  totalMinutesConsulted Int                        @default(0)
  specialisationsJson   Json?
  languagesJson         Json?
  isLiveStreaming       Boolean                    @default(false)
  lastHeartbeatAt       DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount           AstrologerBankAccount?
  documents             AstrologerDocument[]
  schedules             AstrologerSchedule[]
  leaves                AstrologerLeave[]
  queueEntries          ConsultationQueue[]
  rateChangeRequests    RateChangeRequest[]
  withdrawalRequests    WithdrawalRequest[]
  favourites            AstrologerFavourite[]
  followers             AstrologerFollower[]
  availabilitySubs      AvailabilitySubscription[]
  appointments          Appointment[]
  consultationRequests  ConsultationRequest[]

  @@index([verificationStage, availabilityStatus])
  @@index([isOnline, verificationStage])
  @@map("astrologer_profiles")
}

model AstrologerFavourite {
  id                  String            @id @default(cuid())
  userId              String
  astrologerProfileId String
  createdAt           DateTime          @default(now())

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, astrologerProfileId])
  @@map("astrologer_favourites")
}

model AstrologerFollower {
  id                  String            @id @default(cuid())
  userId              String
  astrologerProfileId String
  createdAt           DateTime          @default(now())

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, astrologerProfileId])
  @@map("astrologer_followers")
}

model AvailabilitySubscription {
  id                  String            @id @default(cuid())
  userId              String
  astrologerProfileId String
  channel             String            @default("PUSH") @db.VarChar(32)
  notifiedAt          DateTime?
  createdAt           DateTime          @default(now())

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, astrologerProfileId, channel])
  @@map("availability_subscriptions")
}

model Appointment {
  id                  String            @id @default(cuid())
  customerId          String
  astrologerProfileId String
  birthProfileId      String?           @db.VarChar(64)
  consultationType    String            @default("CHAT") @db.VarChar(32)
  scheduledDate       DateTime          @db.Date
  scheduledTimeSlot   String            @db.VarChar(32)
  durationMinutes     Int               @default(15)
  ratePaisePerMinute  Int
  totalAmountPaise    BigInt
  status              String            @default("PENDING") @db.VarChar(32)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  customer            User              @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)
  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@index([astrologerProfileId, scheduledDate, scheduledTimeSlot])
  @@map("appointments")
}

model ConsultationRequest {
  id                  String            @id @default(cuid())
  customerId          String
  astrologerProfileId String
  birthProfileId      String?           @db.VarChar(64)
  type                String            @default("CHAT") @db.VarChar(32)
  status              String            @default("INITIATED") @db.VarChar(32)
  ratePaisePerMinute  Int
  concern             String?           @db.VarChar(120)
  preferredLanguage   String?           @db.VarChar(32)
  channelName         String?           @db.VarChar(128)
  expiresAt           DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  startedAt           DateTime?
  endedAt             DateTime?
  durationSeconds     Int               @default(0)
  rating              Int?
  review              String?           @db.Text
  createdAt           DateTime          @default(now())

  customer            User              @relation("CustomerConsultationRequests", fields: [customerId], references: [id], onDelete: Cascade)
  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Restrict)
  chatMessages        ChatMessage[]
  stateHistory        ConsultationStateHistory[]
  privateNotes        PrivateConsultationNote[]
  billingRecord       ConsultationBillingRecord?
  consultationReview  ConsultationReview?
  disputes            ConsultationDispute[]

  @@index([customerId, status])
  @@index([astrologerProfileId, status])
  @@map("consultation_requests")
}

model Wallet {
  id                 String              @id @default(cuid())
  userId             String              @unique
  currency           String              @default("INR") @db.VarChar(3)
  paidBalancePaise   BigInt              @default(0)
  promoBalancePaise  BigInt              @default(0)
  refundBalancePaise BigInt              @default(0)
  version            Int                 @default(1)
  updatedAt          DateTime            @updatedAt
  createdAt          DateTime            @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String          @id @default(cuid())
  walletId          String
  idempotencyKey    String          @unique @db.VarChar(128)
  type              LedgerEntryType
  amountPaise       BigInt
  balanceAfterPaise BigInt
  referenceType     String?         @db.VarChar(64)
  referenceId       String?         @db.VarChar(128)
  description       String          @db.VarChar(255)
  metadataJson      Json?
  createdAt         DateTime        @default(now())

  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model SupportTicket {
  id                    String           @id @default(cuid())
  ticketNumber          String           @unique @db.VarChar(32)
  customerId            String
  category              String           @db.VarChar(64)
  subject               String           @db.VarChar(191)
  description           String           @db.Text
  priority              String           @default("NORMAL") @db.VarChar(20)
  status                String           @default("OPEN") @db.VarChar(32)
  relatedTransactionId  String?          @db.VarChar(128)
  relatedConsultationId String?          @db.VarChar(128)
  assignedStaffId       String?          @db.VarChar(64)
  internalNotes         String?          @db.Text
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  customer              User             @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  messages              SupportMessage[]

  @@index([customerId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  senderId      String
  senderRole    UserRole      @default(CUSTOMER)
  message       String        @db.Text
  attachmentUrl String?       @db.VarChar(512)
  createdAt     DateTime      @default(now())

  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender        User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  category  String    @default("GENERAL") @db.VarChar(32)
  title     String    @db.VarChar(191)
  body      String    @db.Text
  actionUrl String?   @db.VarChar(255)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  whatsappEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model SavedAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("HOME") @db.VarChar(32)
  recipientName String   @db.VarChar(120)
  phoneE164     String   @db.VarChar(20)
  streetAddress String   @db.Text
  landmark      String?  @db.VarChar(120)
  city          String   @db.VarChar(80)
  state         String   @db.VarChar(80)
  postalCode    String   @db.VarChar(16)
  country       String   @default("India") @db.VarChar(64)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("saved_addresses")
}

model SystemSetting {
  key         String   @id @db.VarChar(120)
  valueJson   Json
  description String?  @db.VarChar(255)
  updatedBy   String?  @db.VarChar(64)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(128)
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  payloadJson Json?
  createdAt   DateTime @default(now())

  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}


model AstrologerApplication {
  id                      String                 @id @default(cuid())
  userId                  String
  applicationNumber       String                 @unique @db.VarChar(32)
  stage                   VerificationStage      @default(APPLIED)
  status                  String                 @default("PENDING") @db.VarChar(32)
  personalDetailsJson     Json
  professionalDetailsJson Json
  bankDetailsJson         Json?
  adminNotes              String?                @db.Text
  rejectionReason         String?                @db.Text
  submittedAt             DateTime               @default(now())
  reviewedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents               AstrologerDocument[]
  interviews              AstrologerInterview[]

  @@index([userId, status])
  @@index([stage])
  @@map("astrologer_applications")
}

model AstrologerDocument {
  id                  String                 @id @default(cuid())
  applicationId       String?
  astrologerProfileId String?
  type                String                 @db.VarChar(64)
  title               String                 @db.VarChar(191)
  fileUrl             String                 @db.VarChar(512)
  fileSize            Int?
  mimeType            String?                @db.VarChar(64)
  status              String                 @default("PENDING") @db.VarChar(32)
  verificationNotes   String?                @db.Text
  verifiedAt          DateTime?
  createdAt           DateTime               @default(now())

  application         AstrologerApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  astrologerProfile   AstrologerProfile?     @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@index([astrologerProfileId])
  @@map("astrologer_documents")
}

model AstrologerInterview {
  id               String                @id @default(cuid())
  applicationId    String
  scheduledAt      DateTime
  mode             String                @default("VIDEO") @db.VarChar(32)
  meetingLink      String?               @db.VarChar(512)
  interviewerNotes String?               @db.Text
  status           String                @default("SCHEDULED") @db.VarChar(32)
  passed           Boolean?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  application      AstrologerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@map("astrologer_interviews")
}

model AstrologerBankAccount {
  id                  String            @id @default(cuid())
  astrologerProfileId String            @unique
  accountHolderName   String            @db.VarChar(120)
  bankName            String            @db.VarChar(120)
  accountNumberMasked String            @db.VarChar(64)
  ifscCode            String            @db.VarChar(32)
  upiId               String?           @db.VarChar(120)
  isVerified          Boolean           @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@map("astrologer_bank_accounts")
}

model AstrologerSchedule {
  id                  String            @id @default(cuid())
  astrologerProfileId String
  dayOfWeek           Int
  startTime           String            @default("09:00") @db.VarChar(10)
  endTime             String            @default("21:00") @db.VarChar(10)
  isWorkingDay        Boolean           @default(true)
  slotDurationMinutes Int               @default(15)
  breakTimesJson      Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@unique([astrologerProfileId, dayOfWeek])
  @@map("astrologer_schedules")
}

model AstrologerLeave {
  id                  String            @id @default(cuid())
  astrologerProfileId String
  startDate           DateTime          @db.Date
  endDate             DateTime          @db.Date
  reason              String?           @db.VarChar(255)
  status              String            @default("APPROVED") @db.VarChar(32)
  createdAt           DateTime          @default(now())

  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@index([astrologerProfileId, startDate, endDate])
  @@map("astrologer_leaves")
}

model ConsultationQueue {
  id                   String            @id @default(cuid())
  astrologerProfileId  String
  customerId           String
  consultationType     String            @default("CHAT") @db.VarChar(32)
  position             Int               @default(1)
  status               String            @default("WAITING") @db.VarChar(32)
  estimatedWaitMinutes Int               @default(5)
  joinedAt             DateTime          @default(now())
  servicedAt           DateTime?

  astrologerProfile    AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@index([astrologerProfileId, status, position])
  @@map("consultation_queues")
}

model RateChangeRequest {
  id                     String            @id @default(cuid())
  astrologerProfileId    String
  currentChatRatePaise   Int
  proposedChatRatePaise  Int
  currentAudioRatePaise  Int
  proposedAudioRatePaise Int
  currentVideoRatePaise  Int
  proposedVideoRatePaise Int
  reason                 String?           @db.Text
  status                 String            @default("PENDING") @db.VarChar(32)
  adminNotes             String?           @db.Text
  requestedAt            DateTime          @default(now())
  reviewedAt             DateTime?

  astrologerProfile      AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@index([astrologerProfileId, status])
  @@map("rate_change_requests")
}

model WithdrawalRequest {
  id                  String            @id @default(cuid())
  astrologerProfileId String
  requestNumber       String            @unique @db.VarChar(32)
  amountPaise         BigInt
  status              String            @default("PENDING") @db.VarChar(32)
  bankAccountId       String?           @db.VarChar(64)
  payoutReference     String?           @db.VarChar(128)
  adminNotes          String?           @db.Text
  requestedAt         DateTime          @default(now())
  processedAt         DateTime?

  astrologerProfile   AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)

  @@index([astrologerProfileId, status])
  @@map("withdrawal_requests")
}

model DeviceToken {
  id           String    @id @default(cuid())
  userId       String
  token        String    @unique @db.VarChar(512)
  platform     String    @default("WEB") @db.VarChar(32)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@map("device_tokens")
}

model RechargePackage {
  id           String         @id @default(cuid())
  code         String         @unique @db.VarChar(64)
  name         String         @db.VarChar(128)
  amountInr    Int
  amountPaise  BigInt
  bonusPaise   BigInt         @default(0)
  isPopular    Boolean        @default(false)
  badgeText    String?        @db.VarChar(64)
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  orders       PaymentOrder[]

  @@map("recharge_packages")
}

model PaymentOrder {
  id                String           @id @default(cuid())
  orderNumber       String           @unique @db.VarChar(64)
  userId            String
  rechargePackageId String?
  gateway           String           @default("RAZORPAY") @db.VarChar(32)
  gatewayOrderId    String?          @unique @db.VarChar(128)
  gatewayPaymentId  String?          @db.VarChar(128)
  gatewaySignature  String?          @db.VarChar(255)
  amountPaise       BigInt
  taxablePaise      BigInt
  gstPaise          BigInt           @default(0)
  promoBonusPaise   BigInt           @default(0)
  currency          String           @default("INR") @db.VarChar(3)
  status            String           @default("PENDING") @db.VarChar(32)
  failureReason     String?          @db.VarChar(255)
  metadataJson      Json?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rechargePackage   RechargePackage? @relation(fields: [rechargePackageId], references: [id], onDelete: SetNull)
  invoice           GstInvoice?

  @@index([userId, status])
  @@index([gatewayOrderId])
  @@map("payment_orders")
}

model GstInvoice {
  id                 String       @id @default(cuid())
  invoiceNumber      String       @unique @db.VarChar(64)
  orderId            String       @unique
  userId             String
  customerName       String       @db.VarChar(128)
  customerGstin      String?      @db.VarChar(32)
  sacCode            String       @default("998399") @db.VarChar(16)
  taxableAmountPaise BigInt
  cgstPaise          BigInt       @default(0)
  sgstPaise          BigInt       @default(0)
  igstPaise          BigInt       @default(0)
  totalAmountPaise   BigInt
  pdfUrl             String?      @db.VarChar(512)
  issuedAt           DateTime     @default(now())

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order              PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gst_invoices")
}

model ConsultationHold {
  id                 String    @id @default(cuid())
  consultationId     String    @unique
  customerId         String
  ratePaisePerMinute Int
  heldAmountPaise    BigInt
  settledAmountPaise BigInt    @default(0)
  status             String    @default("ACTIVE") @db.VarChar(32)
  createdAt          DateTime  @default(now())
  settledAt          DateTime?

  @@index([customerId, status])
  @@map("consultation_holds")
}

model ChatMessage {
  id              String              @id @default(cuid())
  consultationId  String
  clientMessageId String?             @db.VarChar(128)
  senderId        String
  senderRole      String              @db.VarChar(32)
  type            String              @default("TEXT") @db.VarChar(32)
  content         String              @db.Text
  attachmentUrl   String?             @db.VarChar(512)
  attachmentMeta  Json?
  status          String              @default("SENT") @db.VarChar(32)
  isRead          Boolean             @default(false)
  readAt          DateTime?
  createdAt       DateTime            @default(now())

  consultation    ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@index([clientMessageId])
  @@map("chat_messages")
}

model ConsultationStateHistory {
  id              String              @id @default(cuid())
  consultationId  String
  fromState       String?             @db.VarChar(32)
  toState         String              @db.VarChar(32)
  reason          String?             @db.VarChar(255)
  metadataJson    Json?
  createdAt       DateTime            @default(now())

  consultation    ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@map("consultation_state_history")
}

model ConsultationBillingRecord {
  id                      String              @id @default(cuid())
  consultationId          String              @unique
  totalDurationSeconds    Int                 @default(0)
  billableMinutes         Int                 @default(0)
  ratePaisePerMinute      Int
  totalAmountPaise        BigInt
  promoAmountPaise        BigInt              @default(0)
  paidAmountPaise         BigInt              @default(0)
  astrologerEarningsPaise BigInt
  platformCommissionPaise BigInt
  finalizedAt             DateTime            @default(now())

  consultation            ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_billing_records")
}

model ConsultationReview {
  id                  String              @id @default(cuid())
  consultationId      String              @unique
  customerId          String
  astrologerProfileId String
  rating              Int
  reviewText          String?             @db.Text
  isPublic            Boolean             @default(true)
  createdAt           DateTime            @default(now())

  consultation        ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([astrologerProfileId, isPublic])
  @@map("consultation_reviews")
}

model PrivateConsultationNote {
  id                  String              @id @default(cuid())
  consultationId      String
  astrologerProfileId String
  note                String              @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  consultation        ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("private_consultation_notes")
}

model ConsultationDispute {
  id                String              @id @default(cuid())
  consultationId    String
  raisedById        String
  reason            String              @db.VarChar(255)
  status            String              @default("OPEN") @db.VarChar(32)
  adminNotes        String?             @db.Text
  refundAmountPaise BigInt?
  createdAt         DateTime            @default(now())
  resolvedAt        DateTime?

  consultation      ConsultationRequest @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, status])
  @@map("consultation_disputes")
}
